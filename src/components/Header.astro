---
import { languages, mailto, routes, ui, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page?: PageKey;
  /** URL of this page per language; a missing language links to that language's home page. */
  alternates: Partial<Record<Lang, string>>;
}

const { lang, page, alternates } = Astro.props;
const t = ui[lang];
const isStory = page?.startsWith('story') ?? false;
const isBlog = Astro.url.pathname.startsWith(routes.blog[lang]);

const links = [
  { href: routes.home[lang], label: t.nav.home, active: page === 'home', home: true },
  { href: routes.services[lang], label: t.nav.services, active: page === 'services' },
  { href: `${routes.home[lang]}#success-stories`, label: t.nav.stories, active: isStory },
  { href: routes.blog[lang], label: t.nav.blog, active: isBlog },
];
---

<header class="section header">
  <nav class="container nav" aria-label={t.navLabel}>
    <a href={routes.home[lang]} class="brand">
      <span class="brand-mark" aria-hidden="true">cs</span>
      <span class="brand-name">Christoph Sens</span>
    </a>
    <div class="nav-links">
      <div class="nav-pages">
        {
          links.map((l) => (
            <a href={l.href} class:list={['nav-link', { active: l.active, 'nav-home': l.home }]} aria-current={l.active ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </div>
      <span class="lang" aria-label={t.langSwitchLabel}>
        {
          languages.map((l, i) => (
            <>
              {i > 0 && <span class="lang-sep" aria-hidden="true">/</span>}
              {l === lang ? (
                <span class="lang-current">{l.toUpperCase()}</span>
              ) : (
                <a href={alternates[l] ?? routes.home[l]} hreflang={l} lang={l}>{l.toUpperCase()}</a>
              )}
            </>
          ))
        }
      </span>
      <a class="btn btn-primary nav-cta" href={mailto(lang)}>
        <span class="cta-long">{t.navCta}</span>
        <span class="cta-short">{t.contact.eyebrow}</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 15px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-pages {
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    text-decoration: none;
    font-weight: 500;
  }

  .nav-link.active {
    color: var(--accent-hover);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .lang > * {
    padding: 12px 4px;
  }

  .lang-current {
    font-weight: 500;
  }

  .lang-sep {
    color: var(--dark-subtle);
    padding-inline: 0;
  }

  .lang a {
    text-decoration: none;
    color: var(--muted);
  }

  .nav-cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 15px;
  }

  .cta-short {
    display: none;
  }

  /* Small screens: brand and language switcher on the first row, page links and a short contact
     link on the second. The brand already links home, so the home link is dropped. */
  @media (max-width: 760px) {
    .header {
      padding-block: 14px 6px;
    }

    .nav {
      gap: 2px 12px;
    }

    .nav-links {
      display: contents;
    }

    /* Forces the line break between the two rows. */
    .nav::before {
      content: '';
      flex-basis: 100%;
      order: 1;
    }

    .brand {
      gap: 10px;
    }

    .brand-name {
      font-size: 18px;
    }

    .lang > * {
      padding-inline: 3px;
    }

    .lang-sep {
      padding-inline: 0;
    }

    .nav-pages {
      order: 2;
      gap: 0 18px;
    }

    .nav-link {
      padding-block: 12px;
      font-size: 15px;
    }

    .nav-home,
    .cta-long {
      display: none;
    }

    .cta-short {
      display: inline;
    }

    .nav .nav-cta,
    .nav .nav-cta:hover {
      order: 2;
      margin-left: auto;
      min-height: 44px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      color: var(--accent-hover);
      font-weight: 600;
    }
  }
</style>
