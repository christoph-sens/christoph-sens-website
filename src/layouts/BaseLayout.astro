---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, languages, routes, ui, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Page with versions in all languages (see routes). */
  page?: PageKey;
  /** URL of this page per language, for pages outside routes (e.g. blog posts). */
  alternates?: Partial<Record<Lang, string>>;
  title: string;
  description: string;
  /** Show the contact section above the footer (off for legal pages). */
  contact?: boolean;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { lang, page, title, description, contact = true, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://www.christoph-sens.com');
const alternates: Partial<Record<Lang, string>> = page ? routes[page] : (Astro.props.alternates ?? {});
const translated = languages.every((l) => alternates[l]);
const canonical = new URL(alternates[lang] ?? '/', site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {translated && languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l]!, site)} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang]!, site)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ui[lang].ogLocale} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {/* Keeps Cloudflare's Email Obfuscation from rewriting mailto links: its decoder script is blocked by our CSP. */}
    <Fragment set:html="<!--email_off-->" />
    <Header lang={lang} page={page} alternates={alternates} />
    <main>
      <slot />
    </main>
    {contact && <Contact lang={lang} />}
    <Footer lang={lang} />
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
