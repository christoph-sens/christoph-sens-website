---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { languages, routes, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Page with versions in all languages (see routes). */
  page?: PageKey;
  /** Path of a page that exists in this language only (e.g. German blog posts). */
  path?: string;
  title: string;
  description: string;
  /** Show the contact section above the footer (off for legal pages). */
  contact?: boolean;
}

const { lang, page, path, title, description, contact = true } = Astro.props;
const site = Astro.site ?? new URL('https://www.christoph-sens.com');
const alternates: Partial<Record<Lang, string>> = page ? routes[page] : { [lang]: path };
const canonical = new URL(alternates[lang] ?? '/', site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      page &&
        languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(routes[page][l], site)} />)
    }
    {page && <link rel="alternate" hreflang="x-default" href={new URL(routes[page].de, site)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header lang={lang} page={page} alternates={alternates} />
    <main>
      <slot />
    </main>
    {contact && <Contact lang={lang} />}
    <Footer lang={lang} />
  </body>
</html>
