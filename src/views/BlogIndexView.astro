---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { blogEntries, formatDate } from '../data/blog';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].blog;
const entries = await blogEntries(lang);
const sections = [
  { id: t.anchors.stories, title: t.sections.stories, items: entries.filter((e) => e.category === 'success-story') },
  { id: t.anchors.articles, title: t.sections.articles, items: entries.filter((e) => e.category === 'article') },
];
---

<BaseLayout lang={lang} page="blog" title={t.title} description={t.description}>
  <PageHero lang={lang} eyebrow="Blog" title={t.heroTitle} lead={t.heroLead} />

  {
    sections.map((section) => (
      <section id={section.id} class="section block">
        <div class="container stack">
          <h2 class="h2">{section.title}</h2>
          <ul class="list">
            {section.items.map((e) => (
              <li>
                <a class="card card-link entry" href={e.href}>
                  <time class="mono date" datetime={e.date.toISOString().slice(0, 10)}>
                    {formatDate(e.date, lang)}
                  </time>
                  <h3 class="h3">{e.title}</h3>
                  <p class="muted">{e.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .block {
    padding-block: 0 96px;
  }

  .block:last-of-type {
    padding-bottom: 128px;
  }

  .stack {
    gap: 32px;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 16px;
  }

  .entry {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .date {
    font-size: 13px;
    color: var(--subtle);
  }

  .entry p {
    margin: 0;
    line-height: 1.6;
    max-width: 820px;
  }
</style>
