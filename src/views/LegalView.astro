---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, ui, type Lang } from '../i18n/ui';

import ImpressumDe from '../legal/impressum.de.md';
import ImpressumEn from '../legal/impressum.en.md';
import DatenschutzDe from '../legal/datenschutz.de.md';
import DatenschutzEn from '../legal/datenschutz.en.md';
import ImpressumEs from '../legal/impressum.es.md';
import DatenschutzEs from '../legal/datenschutz.es.md';

interface Props {
  lang: Lang;
  page: 'imprint' | 'privacy';
}

const { lang, page } = Astro.props;
const t = ui[lang].legal[page];
const Content = {
  imprint: { de: ImpressumDe, en: ImpressumEn, es: ImpressumEs },
  privacy: { de: DatenschutzDe, en: DatenschutzEn, es: DatenschutzEs },
}[page][lang];
---

<BaseLayout lang={lang} page={page} title={`${t.title} – Christoph Sens`} description={t.description} contact={false}>
  <section class="section legal">
    <div class="container inner">
      <a class="back" href={routes.home[lang]}>← {ui[lang].back}</a>
      <h1>{t.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: 56px 112px;
  }

  .inner {
    max-width: 820px;
  }

  .back {
    display: inline-block;
    padding: 10px 0;
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    text-decoration: none;
    color: var(--muted);
  }

  h1 {
    margin: 0 0 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
</style>
