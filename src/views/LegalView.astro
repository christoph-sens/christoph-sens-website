---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, ui, type Lang } from '../i18n/ui';

import ImpressumDe from '../legal/impressum.de.md';
import ImpressumEn from '../legal/impressum.en.md';
import DatenschutzDe from '../legal/datenschutz.de.md';
import DatenschutzEn from '../legal/datenschutz.en.md';

interface Props {
  lang: Lang;
  page: 'imprint' | 'privacy';
}

const { lang, page } = Astro.props;
const t = ui[lang].legal[page];
const Content = {
  imprint: { de: ImpressumDe, en: ImpressumEn },
  privacy: { de: DatenschutzDe, en: DatenschutzEn },
}[page][lang];
---

<BaseLayout lang={lang} page={page} title={`${t.title} – Christoph Sens`} description={t.description} contact={false}>
  <section class="section legal">
    <div class="container inner">
      <a class="back" href={routes.home[lang]}>← {ui[lang].back}</a>
      <h1>{t.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: 56px 112px;
  }

  .inner {
    max-width: 820px;
  }

  .back {
    display: inline-block;
    padding: 10px 0;
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    text-decoration: none;
    color: var(--muted);
  }

  h1 {
    margin: 0 0 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .prose {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .prose :global(h2) {
    margin: 56px 0 16px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin: 32px 0 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink);
  }

  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 16px;
  }

  .prose :global(ul) {
    padding-left: 22px;
  }

  .prose :global(hr) {
    margin: 48px 0 16px;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(em) {
    color: var(--muted);
  }
</style>
