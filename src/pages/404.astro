---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../i18n/ui';

/** Cloudflare Pages serves this for unknown paths with status 404 (without it, every unknown path returns the home page). */
const notFound = [
  { lang: 'en', title: 'Page not found', text: 'This page doesn’t exist (anymore).', link: 'To the home page' },
  { lang: 'de', title: 'Seite nicht gefunden', text: 'Diese Seite gibt es nicht (mehr).', link: 'Zur Startseite' },
  { lang: 'es', title: 'Página no encontrada', text: 'Esta página no existe (o ya no existe).', link: 'Ir a la página de inicio' },
] as const;
---

<BaseLayout lang="en" title="Page not found – Christoph Sens" description="This page doesn’t exist." noindex>
  <section class="section not-found">
    <div class="container inner">
      <div class="kicker mono"><span class="dot" aria-hidden="true"></span>404</div>
      {
        notFound.map((t, i) => (
          <div class="entry" lang={t.lang}>
            {i === 0 ? <h1>{t.title}</h1> : <h2>{t.title}</h2>}
            <p class="muted">{t.text}</p>
            <a class="text-link" href={routes.home[t.lang]} hreflang={t.lang}>
              {t.link} →
            </a>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 96px 128px;
  }

  .inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  h1 {
    font-size: clamp(40px, 5vw, 64px);
  }

  h2 {
    font-size: clamp(26px, 3vw, 34px);
  }

  .entry p {
    margin: 0;
  }
</style>
